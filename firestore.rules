rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVendor() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["vendor", "both"];
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if isOwner(userId);
    }

    match /gadgets/{gadgetId} {
      allow read: if signedIn();
      allow create: if isVendor() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isVendor() && resource.data.vendorId == request.auth.uid && request.resource.data.vendorId == request.auth.uid;
      allow delete: if isVendor() && resource.data.vendorId == request.auth.uid;
    }
  }
}
